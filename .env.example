APP_ENV=LOCAL
# npm run db:start generates a private local .env with random credentials.
DATABASE_URL=postgresql://replace-user:replace-password@127.0.0.1:55432/formation_zero
AUTH_SECRET=replace-with-at-least-32-random-characters
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
PORT=4000
MAIL_MODE=LOCAL
LEGAL_COMMERCIAL_GATE_APPROVED=false
# STAGING/PRODUCTION require HTTPS origins, verified DB TLS, MAIL_MODE=SMTP,
# SMTP_URL=smtps://<account>:<credential>@<host>:465 and MAIL_FROM.
